{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "HDR Auto-Switch",
  "version": "1.0.10",

  "identifier": "com.soptik.hdr-autoswitch",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "HDR Auto-Switch",
        "width": 1280,
        "height": 720,
        "minWidth": 940,
        "minHeight": 580,
        "resizable": true,
        "fullscreen": false,
        "visible": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "windows": {
      "nsis": {
        "installMode": "currentUser",
        "template": "windows\\installer.nsi"
      },
      "wix": {
        "upgradeCode": "30b00949-76aa-5c71-b9aa-0599499ac6de",
        "template": "windows\\main.wxs"
      }
    },
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
